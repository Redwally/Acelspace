PORT=3000
# Generate a unique value with: openssl rand -hex 32
COOKIE_SECRET=
# Generate a bcrypt hash for a strong admin password; never use a sample password.
ADMIN_PASSWORD_HASH=
PUBLIC_ORIGIN=https://your-domain.example
ALLOWED_ORIGIN=https://your-domain.example

# Optional email delivery. Use a newly generated application password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Discord backup notification webhook.
DISCORD_WEBHOOK_URL=
