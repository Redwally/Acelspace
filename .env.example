PORT=3000
# Generate a unique value with: openssl rand -hex 32
COOKIE_SECRET=
# Generate a bcrypt hash for a strong admin password; never use a sample password.
ADMIN_PASSWORD_HASH=
PUBLIC_ORIGIN=https://your-domain.example
ALLOWED_ORIGIN=https://your-domain.example

# Optional email delivery. Use a newly generated application password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=

# Optional Discord backup notification webhook.
DISCORD_WEBHOOK_URL=

# Cloudflare Turnstile anti-bot (get real keys at https://dash.cloudflare.com/)
# Set to false to disable captcha during local development / testing
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
